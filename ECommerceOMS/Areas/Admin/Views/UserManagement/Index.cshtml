@using System.Security.Claims
@using ECommerceOMS.Models.Identity
@using ECommerceOMS.Services
@model List<ApplicationUser>
@inject UserService UserService

@{
    ViewData["Title"] = "Users";
    Layout = "/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1>User Management</h1>

@if (TempData["Error"] is string error)
{
    <div class="alert">@error</div>
}

<table>
    <thead>
        <tr>
            <th>Email</th>
            <th>Display Name</th>
            <th>Role</th>
            <th>Status</th>
            <th class="col-actions">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            var userRole = await UserService.GetRoleAsync(user.Email);

            <tr class="@(user.isLocked ? "user-inactive" : "")">
                <td>@user.Email</td>
                <td>@user.DisplayName</td>
                <td>@userRole</td>
                <td>@(user.isLocked ? "Locked" : "Unlocked")</td>
                <td class="col-actions">
                    <div class="user-actions">
                        <form class="role-form" asp-area="Admin" asp-controller="UserManagement" asp-action="ChangeRole" method="post">
                            <input type="hidden" name="email" value="@user.Email"/>
                            <select name="newRole">
                                <option selected="@(userRole == RoleType.Buyer.ToName())" value="@RoleType.Buyer">Buyer</option>
                                <option selected="@(userRole == RoleType.Seller.ToName())" value="@RoleType.Seller">Seller</option>
                                @if (User.FindFirst(ClaimTypes.Role)?.Value == RoleType.SuperAdmin.ToName())
                                {
                                    <option selected="@(userRole == RoleType.Admin.ToName())" value="@RoleType.Admin">Admin</option>
                                    <option selected="@(userRole == RoleType.SuperAdmin.ToName())" value="@RoleType.SuperAdmin">SuperAdmin</option>

                                }
                            </select>
                            <button type="submit" class="btn">Update</button>
                        </form>
                        <form class="lock-form" asp-area="Admin" asp-controller="UserManagement" asp-action="ToggleLock" method="post">
                            <input type="hidden" name="email" value="@user.Email"/>
                            <button type="submit" class="btn btn-delete">
                                @(user.isLocked ? "Unlock" : "Lock")
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>