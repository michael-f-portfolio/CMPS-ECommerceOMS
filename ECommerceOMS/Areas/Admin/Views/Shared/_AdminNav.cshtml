@using System.Security.Claims
@using ECommerceOMS.Models.Identity

<nav>
    <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
    <a asp-area="Admin" asp-controller="Home" asp-action="Index">Admin Dashboard</a>
    <a asp-area="Admin" asp-controller="ProductManagement" asp-action="Index">Product Management</a>
    <a asp-area="Admin" asp-controller="CartManagement" asp-action="Index">Cart Management</a>
    <a asp-area="Admin" asp-controller="Orders" asp-action="Index">Orders</a>
    <a asp-area="Admin" asp-controller="UserManagement" asp-action="Index">User Management</a>

    @{
        var role = User.FindFirst(ClaimTypes.Role)?.Value;
        if (role == RoleType.SuperAdmin.ToName())
        {
            <a asp-area="Admin" asp-controller="AdminManagement" asp-action="Index">Admin Management</a>
        }
    }

    <a asp-area="" asp-controller="Account" asp-action="Logout">Logout</a>
</nav>