@model List<ECommerceOMS.ViewModels.AdminCartEditViewModel>

@{
    ViewData["Title"] = "Carts";
    Layout = "/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Cart Management</h2>

@if (TempData["Message"] != null)
{
    <div class="alert">@TempData["Message"]</div>
}

@if (Model.Count == 0)
{
    <div class="alert">There are no carts to manage.</div>
}
else
{
    <table>
        <thead>
        <tr>
            <th>Buyer</th>
            <th>Items</th>
            <th>Total Value</th>
            <th class="col-actions">Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var cart in Model)
        {
            <tr>
                <td>@cart.BuyerDisplayName</td>
                <td class="number-column">@cart.ItemCount</td>
                <td class="currency-column">@cart.TotalValue.ToString("C")</td>
                <td class="col-actions">
                    <div class="action-buttons">
                        <form asp-action="Clear" method="post">
                            <input type="hidden" name="cartId" value="@cart.CartId"/>
                            <button class="btn btn-delete">Clear Cart</button>
                        </form>    
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
}