@model Product

@{
    ViewData["Title"] = "Delete";
    Layout = "/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Delete Product</h2>

<div>Are you sure you want to delete this product?</div>

<div>@Model.Name</div>
<div>Price: @Model.Price.ToString("C")</div>
<div>Quantity: @Model.QuantityOnHand</div>
<div>Status: @(Model.IsActive ? "Active" : "Inactive")</div>
<div>Seller: @Model.Seller?.UserName / @Model.Seller?.Email</div>

@if (Model.ImageData != null)
{
    <div>
        Image: <br/>
        <img src="data:image/png;base64,@Convert.ToBase64String(Model.ImageData)"
             style="width:120px;height:120px;object-fit:cover;border-radius:4px;" 
             alt="@Model.Name"/>
    </div>
}

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id"/>
    <button type="submit">Delete</button>
    <a asp-action="Index">Cancel</a>
</form>