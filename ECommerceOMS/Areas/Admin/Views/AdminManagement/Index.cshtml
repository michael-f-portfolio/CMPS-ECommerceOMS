@using System.Security.Claims
@using ECommerceOMS.Models.Identity
@using ECommerceOMS.Services
@model List<ApplicationUser>
@inject UserService UserService

@{
    Layout = "/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1>Admin Management</h1>

@if (TempData["Error"] is string error)
{
    <div>@error</div>
}

@if (Model.Count == 0 || Model.Count == 1)
{
    <span>There are no admins to manage.</span>
}
else
{
    <table>
        <thead>
        <tr>
            <th>Email</th>
            <th>Display Name</th>
            <th>Role</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var admin in Model)
        {
            if (User.Identity.Name != admin.UserName)
            {
                var adminRole = await UserService.GetRoleAsync(admin.Email);

                <tr>
                    <td>@admin.Email</td>
                    <td>@admin.DisplayName</td>
                    <td>@adminRole</td>
                    <td>@(admin.isLocked ? "Locked" : "Unlocked")</td>
                    <td>
                        <form asp-area="Admin" asp-controller="AdminManagement" asp-action="ChangeRole">
                            <input type="hidden" name="email" value="@admin.Email"/>
                            <select name="newRole">
                                <option value="@RoleType.Buyer">Buyer</option>
                                <option value="@RoleType.Seller">Seller</option>
                                @if (User.FindFirst(ClaimTypes.Role)?.Value == RoleType.SuperAdmin.ToName() &&
                                     !adminRole.Equals(RoleType.Admin.ToName()))
                                {
                                    <option value="@RoleType.Admin">Admin</option>
                                }
                                @if (User.FindFirst(ClaimTypes.Role)?.Value == RoleType.SuperAdmin.ToName() &&
                                     !adminRole.Equals(RoleType.SuperAdmin.ToName()))
                                {
                                    <option value="@RoleType.SuperAdmin">Super Admin</option>
                                }
                            </select>
                            <button type="submit">Change Role</button>
                        </form>
                        @*
                        @if (adminRole.Equals(RoleType.Admin.ToName()))
                        {
                            <form asp-area="Admin" asp-controller="AdminManagement" asp-action="PromoteToSuperAdmin" method="post">
                                <input type="hidden" name="email" value="@admin.Email"/>
                                <button type="submit">Promote to SuperAdmin</button>
                            </form>
                        }
                        else if (adminRole.Equals(RoleType.SuperAdmin.ToName()))
                        {
                            <form asp-area="Admin" asp-controller="AdminManagement" asp-action="DemoteToAdmin" method="post">
                                <input type="hidden" name="email" value="@admin.Email"/>
                                <button type="submit">Demote to Admin</button>
                            </form>
                        }
                        *@
                        <form asp-area="Admin" asp-controller="AdminManagement" asp-action="ToggleLock" method="post">
                            <input type="hidden" name="email" value="@admin.Email"/>
                            <button type="submit">
                                @(admin.isLocked ? "Unlock" : "Lock")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
}