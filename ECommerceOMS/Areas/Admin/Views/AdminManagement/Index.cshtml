@using System.Security.Claims
@using ECommerceOMS.Models.Identity
@using ECommerceOMS.Services
@model List<ApplicationUser>
@inject UserService UserService

@{
    ViewData["Title"] = "";
    Layout = "/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1>Admin Management</h1>

@if (TempData["Error"] is string error)
{
    <div class="alert">@error</div>
}

@if (Model.Count == 0 || Model.Count == 1)
{
    <span>There are no admins to manage.</span>
}
else
{
    <table>
        <thead>
        <tr>
            <th>Email</th>
            <th>Display Name</th>
            <th>Role</th>
            <th>Status</th>
            <th class="col-actions">Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var admin in Model)
        {
            if (User.Identity.Name != admin.UserName)
            {
                var adminRole = await UserService.GetRoleAsync(admin.Email);

                <tr class="@(admin.isLocked ? "user-inactive" : "")">
                    <td>@admin.Email</td>
                    <td>@admin.DisplayName</td>
                    <td>@adminRole</td>
                    <td>@(admin.isLocked ? "Locked" : "Unlocked")</td>
                    <td class="col-actions">
                        <div class="user-actions">
                            <form class="role-form" asp-area="Admin" asp-controller="AdminManagement" asp-action="ChangeRole">
                            <input type="hidden" name="email" value="@admin.Email"/>
                            <select name="newRole">
                                <option selected="@(adminRole == RoleType.Buyer.ToName())" value="@RoleType.Buyer">Buyer</option>
                                <option selected="@(adminRole == RoleType.Seller.ToName())" value="@RoleType.Seller">Seller</option>
                                @if (User.FindFirst(ClaimTypes.Role)?.Value == RoleType.SuperAdmin.ToName())
                                {
                                    <option selected="@(adminRole == RoleType.Admin.ToName())" value="@RoleType.Admin">Admin</option>
                                    <option selected="@(adminRole == RoleType.SuperAdmin.ToName())" value="@RoleType.SuperAdmin">Super Admin</option>
                                    
                                }
                            </select>
                            <button type="submit">Update</button>
                            </form>
                            <form class="lock-form" asp-area="Admin" asp-controller="AdminManagement" asp-action="ToggleLock" method="post">
                                <input type="hidden" name="email" value="@admin.Email"/>
                                <button type="submit" class="btn btn-delete">
                                    @(admin.isLocked ? "Unlock" : "Lock")
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
}