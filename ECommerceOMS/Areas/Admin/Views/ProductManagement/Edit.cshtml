@model ECommerceOMS.ViewModels.ProductEditViewModel

@{
    ViewData["Title"] = "Edit Product";
    Layout = "/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Edit Product</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id"/>
    
    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name"/>
        <span asp-validation-for="Name"></span>
    </div>
    
    <div>
        <label asp-for="Description"></label>
        <textarea asp-for="Description"></textarea>
        <span asp-validation-for="Description"></span>
    </div>
    
    <div>
        <label asp-for="Price"></label>
        <input asp-for="Price"/>
        <span asp-validation-for="Price"></span>
    </div>
    
    <div>
        <label asp-for="QuantityOnHand"></label>
        <input asp-for="QuantityOnHand"></input>
        <span asp-validation-for="QuantityOnHand"></span>
    </div>
    <div>
        <label asp-for="IsActive"></label>
        <input asp-for="IsActive" type="checkbox" />
        <span asp-validation-for="IsActive"></span>
    </div>
    <div>
        <label>Current Image</label> <br/>
        @if (Model.ExistingImageBase64 != null)
        {
            <img src="data:image/png;base64, @Model.ExistingImageBase64" 
                 style="width:60px;height:60px;object-fit: cover; border-radius: 4px" 
                 alt="@Model.Name"/>
        }
        else
        {
            <p>No image uploaded.</p>
        }
    </div>
    
    <div>
        <label>Upload New Image</label>
        <input type="file" name="imageFile"/>
    </div>
    
    <button type="submit">Save Changes</button>
    <a asp-action="Index">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}