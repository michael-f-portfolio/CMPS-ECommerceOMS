@model List<Product>

@{
    ViewData["Title"] = "Products";
    Layout = "/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Products</h2>

<table>
    <thead>
        <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Price</th>
            <th>Qty</th>
            <th>Status</th>
            <th>Seller</th>
            <th style="width: 200px"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>
                    @if (p.ImageData != null)
                    {
                        <img src="data:image/png;base64, @Convert.ToBase64String(p.ImageData)" 
                             style="width:60px;height:60px;object-fit: cover; border-radius: 4px" 
                             alt="@p.Name"/>
                    }
                </td>
                <td>@p.Name</td>
                <td>@p.Price.ToString("C")</td>
                <td>@p.QuantityOnHand</td>
                <td>
                    @if (p.IsActive)
                    {
                        <span>Active</span>
                    }
                    else
                    {
                        <span>Inactive</span>
                    }
                </td>
                <td>@p.Seller?.UserName</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@p.Id">Edit</a>
                    <a asp-action="Delete" asp-route-id="@p.Id">Delete</a>

                    <form asp-action="Toggle" asp-route-id="@p.Id" method="post">
                        <button type="submit">@(p.IsActive ? "Deactivate" : "Activate")</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>