@model List<Product>

@{
    ViewData["Title"] = "Products";
    Layout = "/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Products</h2>

<table>
    <thead>
        <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Qty</th>
            <th>Status</th>
            <th>Seller</th>
            <th class="col-actions">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr class="@(p.IsActive ? "" : "product-inactive")">
                <td>
                    @if (p.ImageData != null)
                    {
                        <img src="data:image/png;base64, @Convert.ToBase64String(p.ImageData)" 
                             class="product-image-preview" 
                             alt="@p.Name"/>
                    }
                </td>
                <td>@p.Name</td>
                <td>@p.Category</td>
                <td>@p.Price.ToString("C")</td>
                <td>@p.QuantityOnHand</td>  
                <td>
                    @if (p.IsActive)
                    {
                        <span>Active</span>
                    }
                    else
                    {
                        <span>Inactive</span>
                    }
                </td>
                <td>@p.Seller?.UserName</td>
                <td class="col-actions">
                    <div class="action-buttons">
                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-edit">Edit</a>
                        <form asp-action="Toggle" asp-route-id="@p.Id" method="post">
                            <button type="submit" class="btn btn-delete">
                                @(p.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>    
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>