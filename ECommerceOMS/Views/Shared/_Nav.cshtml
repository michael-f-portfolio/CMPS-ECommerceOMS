@using System.Security.Claims
@using ECommerceOMS.Models.Identity

<nav>
    <a asp-controller="Home" asp-action="Index">Home</a>

    @if (User.Identity.IsAuthenticated)
    {
        var displayName = User.FindFirst("DisplayName")?.Value ?? User.Identity.Name;
        var role = User.FindFirst(ClaimTypes.Role)?.Value;

        <span>Hello, @displayName</span>

        if (role == RoleType.Buyer.ToName())
        {
            <a asp-controller="Cart" asp-action="Index">My Cart</a>
            <a asp-controller="Orders" asp-action="Index">My Orders</a>
        }

        if (role == RoleType.Seller.ToName())
        {
            <a asp-controller="Seller" asp-action="Index">My Products</a> 
        }

        if (role == RoleType.Admin.ToName() || role == RoleType.SuperAdmin.ToName())
        {
            <a asp-area="Admin" asp-controller="Home" asp-action="Index">Admin Dashboard</a>
        }

        <a asp-controller="Account" asp-action="Logout">Logout</a>
    }
    else
    {
        <a asp-controller="Account" asp-action="Login">Login</a>
        <a asp-controller="Account" asp-action="Register">Register</a>
    }
</nav>