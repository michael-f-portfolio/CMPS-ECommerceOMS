@model List<Product>

@{
    ViewData["Title"] = "Seller Dashboard";
}

<h2>My Products</h2>

<a asp-action="Create" class="btn btn-edit">Create Product</a>

<table>
    <thead>
    <tr>
        <th>Image</th>
        <th>Name</th>
        <th>Category</th>
        <th>Price</th>
        <th>Qty</th>
        <th>Status</th>
        <th class="col-actions" >Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr class="@(p.IsActive ? "" : "product-inactive")">
            <td>
                @if (p.ImageData != null)
                {
                    <img src="data:image/png;base64, @Convert.ToBase64String(p.ImageData)" 
                         class="product-image-preview" 
                         alt="@p.Name"/>
                }
            </td>
            <td>@p.Name</td>
            <td>@p.Category</td>
            <td>
                @if (p.DiscountPercentage > 0)
                {
                    <p>
                        <span class="old-price">
                            @p.Price.ToString("C")
                        </span>
                        
                        <span class="discount-price">
                            @p.DiscountedPrice.ToString("C")
                        </span>
                        <span class="discount-badge">
                            (@p.DiscountPercentage% off)
                        </span>
                    </p>   
                }
                else
                {
                    <span>
                        @p.Price.ToString("C")
                    </span>
                }
            </td>
            <td>@p.QuantityOnHand</td>
            <td>
                @if (p.IsActive)
                {
                    <span>Active</span>
                }
                else
                {
                    <span>Inactive</span>
                }
            </td>
            <td class="col-actions">
                <div class="action-buttons">
                    <a class="btn btn-edit" asp-action="Edit" asp-route-id="@p.Id" >Edit</a>
                    <form asp-action="Toggle" asp-route-id="@p.Id" method="post">
                        <button class="btn btn-delete" type="submit">
                            @(p.IsActive ? "Deactivate" : "Activate")
                        </button>
                    </form>                    
                </div>

            </td>
        </tr>
    }
    </tbody>
</table>