@model List<Product>

@{
    ViewData["Title"] = "Seller Dashboard";
}

<h2>My Products</h2>

<a asp-action="Create" class="btn btn-edit">Create Product</a>

<table>
    <thead>
    <tr>
        <th>Image</th>
        <th>Name</th>
        <th>Category</th>
        <th>Price</th>
        <th>Qty</th>
        <th>Status</th>
        <th style="width: 200px"></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>
                @if (p.ImageData != null)
                {
                    <img src="data:image/png;base64, @Convert.ToBase64String(p.ImageData)" 
                         style="width:60px;height:60px;object-fit: cover; border-radius: 4px" 
                         alt="@p.Name"/>
                }
            </td>
            <td>@p.Name</td>
            <td>@p.Category</td>
            <td>
                @if (p.DiscountPercentage > 0)
                {
                    <p>
                        <span class="old-price">
                            @p.Price.ToString("C")
                        </span>
                        
                        <span class="discount-price">
                            @p.DiscountedPrice.ToString("C")
                        </span>
                        <span class="discount-badge">
                            (@p.DiscountPercentage% off)
                        </span>
                    </p>   
                }
            </td>
            <td>@p.QuantityOnHand</td>
            <td>
                @if (p.IsActive)
                {
                    <span>Active</span>
                }
                else
                {
                    <span>Inactive</span>
                }
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-edit">Edit</a>
                <form asp-action="Toggle" asp-route-id="@p.Id" method="post">
                    <button type="submit">@(p.IsActive ? "Deactivate" : "Activate")</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>