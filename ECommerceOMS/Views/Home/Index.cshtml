@model List<Product>

@{
    ViewData["Title"] = "Home";
}

<h2>Products</h2>

<div>
    @foreach (var p in Model)
    {
        <div>
            <img src="data:image/png;base64,@Convert.ToBase64String(p.ImageData)" 
                 alt="@p.Name" style="width:150px;height:150px;object-fit:cover" />

            <h3>@p.Name</h3>
            <p>@p.Description</p>
            <p><strong>@p.Price.ToString("C")</strong></p>

            <form asp-controller="Cart" asp-action="Add" method="post">
                <input type="hidden" name="productId" value="@p.Id" />
                <button type="submit">Add to Cart</button>
            </form>
        </div>
    }
</div>