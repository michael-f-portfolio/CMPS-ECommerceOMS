@model List<Order>

<h2>Your Orders</h2>

@if (!Model.Any())
{
    <p>You have no orders.</p>
}
else
{
    <table>
        <thead>
        <tr>
            <th>Order #</th>
            <th>Date</th>
            <th>Total</th>
            <th>Status</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.Id</td>
                <td>@order.CreatedAt.ToString("yyyy-MM-dd")</td>
                <td>@order.TotalCost.ToString("C")</td>
                <td>@order.OrderStatus</td>
                <td>
                    <a asp-action="Details" asp-route-id="@order.Id">View</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}